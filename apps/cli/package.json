{
  "name": "maya-os",
  "version": "0.0.1",
  "description": "Maya \u2014 a local-first AI operating system for developers. One command: models, coding agents, teams, and a Loop Agent lead on your Mac.",
  "license": "MIT",
  "author": "Himansh Raj <iamthehimansh@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "maya": "./bin/maya.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maya-ai/core": "workspace:*",
    "@maya-ai/model-runtime": "workspace:*",
    "@maya-ai/gateway": "workspace:*",
    "@maya-ai/bus": "workspace:*",
    "@maya-ai/orchestrator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22"
  },
  "keywords": [
    "ai",
    "agents",
    "llama.cpp",
    "gguf",
    "claude-code",
    "apple-silicon",
    "local-first"
  ]
}
