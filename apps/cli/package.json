{
  "name": "maya-os",
  "version": "0.0.1",
  "description": "Local-first AI OS for developers \u2014 model gateway with RAM guardrails, real-PTY Claude Code agent teams, proactive agents, verified loops, web dashboard. One command: maya serve.",
  "license": "MIT",
  "author": "Himansh Raj <iamthehimansh@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "maya": "./bin/maya.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "templates",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "@maya-ai/bus": "workspace:*",
    "@maya-ai/core": "workspace:*",
    "@maya-ai/dashboard": "workspace:*",
    "@maya-ai/gateway": "workspace:*",
    "@maya-ai/hwfit": "workspace:*",
    "@maya-ai/mcp": "workspace:*",
    "@maya-ai/model-runtime": "workspace:*",
    "@maya-ai/orchestrator": "workspace:*"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "claude-code",
    "llama.cpp",
    "local-llm",
    "gguf",
    "orchestrator",
    "multi-agent",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iamthehimansh/maya"
  }
}